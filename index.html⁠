<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>배우 김윤식 아카이브</title>
  <style>
    /* 기본 배경 및 폰트 설정 */
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; background-color: #fafafa; color: #262626; }
    .container { max-width: 935px; margin: 0 auto; padding: 30px 20px; }
    
    /* 상단 프로필 영역 */
    .profile { display: flex; align-items: center; margin-bottom: 40px; padding-bottom: 40px; border-bottom: 1px solid #dbdbdb; }
    .profile-img { width: 150px; height: 150px; border-radius: 50%; margin-right: 50px; object-fit: cover; border: 1px solid #efefef; }
    .profile-info h1 { font-weight: 300; font-size: 28px; margin: 0 0 15px; }
    .profile-info p { font-size: 16px; line-height: 1.5; white-space: pre-wrap; }
    
    /* 3열 피드 (그리드) */
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
    .grid-item { aspect-ratio: 1 / 1; background-color: #efefef; cursor: pointer; position: relative; overflow: hidden; }
    .grid-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s; }
    .grid-item:hover img { transform: scale(1.05); }

    /* 인스타 스타일 팝업(모달) 창 */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); z-index: 1000; align-items: center; justify-content: center; }
    .modal.active { display: flex; }
    .modal-content { display: flex; width: 95%; max-width: 1000px; height: 90vh; background: white; border-radius: 4px; overflow: hidden; position: relative; }
    
    /* 팝업: 왼쪽 미디어(사진/영상) 영역 */
    .modal-media { flex: 1; background: black; display: flex; align-items: center; justify-content: center; position: relative; }
    .modal-media img, .modal-media video { max-width: 100%; max-height: 100%; object-fit: contain; display: none; }
    .modal-media img.active, .modal-media video.active { display: block; }
    
    /* 사진 넘기기 버튼 (<, >) */
    .nav-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.8); border: none; border-radius: 50%; width: 32px; height: 32px; cursor: pointer; font-size: 16px; display: none; z-index: 10; }
    .prev-btn { left: 15px; }
    .next-btn { right: 15px; }

    /* 팝업: 오른쪽 글(멘트) 영역 */
    .modal-text { width: 350px; display: flex; flex-direction: column; background: white; border-left: 1px solid #efefef; }
    .modal-header { display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #efefef; font-weight: bold; }
    .modal-header img { width: 32px; height: 32px; border-radius: 50%; margin-right: 12px; object-fit: cover; }
    .modal-caption { padding: 15px; overflow-y: auto; font-size: 14px; line-height: 1.6; }
    
    /* 닫기 버튼 (X) */
    .close-btn { position: absolute; top: 15px; right: 25px; color: white; font-size: 35px; cursor: pointer; font-weight: 300; }

    /* 모바일 화면 맞춤 설정 */
    @media (max-width: 768px) {
      .profile-img { width: 80px; height: 80px; margin-right: 20px; }
      .grid { gap: 3px; }
      .modal-content { flex-direction: column; height: auto; max-height: 95vh; }
      .modal-text { width: 100%; height: 30vh; border-left: none; border-top: 1px solid #efefef; }
      .modal-media { height: 65vh; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="profile">
      <img src="https://via.placeholder.com/150" alt="프로필" class="profile-img">
      <div class="profile-info">
        <h1>kimyoonsik_</h1>
        <p>배우 김윤식 아카이빙 사이트입니다.<br>출연작 및 일상 기록 🎬</p>
      </div>
    </div>

    <div class="grid">
      <div class="grid-item" onclick="openPost(post1)">
        <img src="https://via.placeholder.com/500/cccccc" alt="썸네일 1">
      </div>
      <div class="grid-item" onclick="openPost(post2)">
        <img src="https://via.placeholder.com/500/999999" alt="썸네일 2">
      </div>
    </div>
  </div>

  <div class="modal" id="modal" onclick="closeModal()">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <div class="modal-content" onclick="event.stopPropagation()">
      
      <div class="modal-media">
        <button class="nav-btn prev-btn" onclick="moveSlide(-1)">&#10094;</button>
        <div id="media-container"></div>
        <button class="nav-btn next-btn" onclick="moveSlide(1)">&#10095;</button>
      </div>
      
      <div class="modal-text">
        <div class="modal-header">
          <img src="https://via.placeholder.com/150" alt="프로필">
          <span>kimyoonsik_</span>
        </div>
        <div class="modal-caption" id="caption-container"></div>
      </div>

    </div>
  </div>

  <script>
    /* =======================================
       여기에 내 사진과 멘트를 입력하세요! 
       ======================================= */
    
    // 1번 게시물 데이터
    const post1 = {
      media: [
        { type: 'image', src: 'https://via.placeholder.com/800/cccccc/000000?text=Photo+1' },
        { type: 'image', src: 'https://via.placeholder.com/800/bbbbbb/000000?text=Photo+2' }
      ],
      caption: "첫 번째 아카이빙입니다. 🎉<br><br>여러 장의 사진을 올릴 수 있고,<br>옆으로 화살표를 눌러 넘겨볼 수 있어요!"
    };

    // 2번 게시물 데이터 (영상 포함 예시)
    const post2 = {
      media: [
        { type: 'video', src: 'https://www.w3schools.com/html/mov_bbb.mp4' },
        { type: 'image', src: 'https://via.placeholder.com/800/999999/ffffff?text=Behind+Scene' }
      ],
      caption: "동영상도 아주 잘 들어갑니다! 🎥<br>#배우 #김윤식 #촬영현장"
    };

    /* =======================================
       아래는 건드리지 않아도 되는 작동 코드입니다
       ======================================= */
    let currentIndex = 0;
    let currentData = null;

    function openPost(post) {
      currentData = post;
      currentIndex = 0;
      document.getElementById('caption-container').innerHTML = post.caption;
      
      const mediaBox = document.getElementById('media-container');
      mediaBox.innerHTML = ''; 
      
      post.media.forEach((item, idx) => {
        let el = document.createElement(item.type === 'video' ? 'video' : 'img');
        el.src = item.src;
        if(item.type === 'video') el.controls = true;
        if(idx === 0) el.classList.add('active');
        mediaBox.appendChild(el);
      });

      updateButtons();
      document.getElementById('modal').classList.add('active');
      document.body.style.overflow = 'hidden'; // 배경 스크롤 방지
    }

    function closeModal() {
      document.getElementById('modal').classList.remove('active');
      document.body.style.overflow = '';
      const videos = document.querySelectorAll('#media-container video');
      videos.forEach(v => v.pause()); // 닫을 때 영상 자동 정지
    }

    function moveSlide(direction) {
      const items = document.querySelectorAll('#media-container > *');
      items[currentIndex].classList.remove('active');
      currentIndex += direction;
      items[currentIndex].classList.add('active');
      updateButtons();
    }

    function updateButtons() {
      document.querySelector('.prev-btn').style.display = currentIndex > 0 ? 'block' : 'none';
      document.querySelector('.next-btn').style.display = currentIndex < currentData.media.length - 1 ? 'block' : 'none';
    }
  </script>
</body>
</html>
